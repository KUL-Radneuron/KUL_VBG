# Python bytecode — produced whenever KUL_VBG_QC.py / KUL_lesion_overlap.py
# are imported rather than executed directly.
__pycache__/
*.py[cod]

# Container build artefacts. Also covered by Docker/.gitignore, repeated here
# so a `git add -A` from the repo root can never stage a ~15 GB SIF.
*.sif
*.docker.tar
Docker/build_*.log
